# 微课堂 MicroClass —— 环境变量示例
#
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会进仓库）。
# 生产环境请**务必**修改 MC_ADMIN_PASS 与 MC_SESSION_SECRET。

# ---- 运行环境 ----
MC_ENV=production              # production | development | test
MC_HOST=0.0.0.0
MC_PORT=8091
MC_SITE_NAME=微课堂
MC_LOG_LEVEL=info              # silent | error | warn | info | debug

# ---- 数据与静态资源 ----
MC_DATA_DIR=/app/data          # SQLite、上传文件、课程封面等的根目录
MC_WEB_DIST=./apps/web/dist    # 前端构建产物目录（API 同时托管 SPA）
MC_MIGRATIONS_DIR=./db/migrations

# ---- 首次部署的管理员（仅首次初始化时生效）----
MC_ADMIN_USER=admin
MC_ADMIN_PASS=change-me-please

# ---- 安全 ----
MC_SESSION_SECRET=please-change-to-a-long-random-string
MC_ALLOW_REGISTER=false        # 是否开放注册
MC_ALLOWED_ORIGINS=            # 额外允许的跨域来源（逗号分隔，留空=同源）
MC_TRUST_PROXY=false           # 部署在反向代理之后时设为 true
MC_CSP=                        # 需要自定义内容安全策略时填写
MC_RATE_LIMIT_MAX=300          # 每个窗口的请求上限
MC_RATE_LIMIT_WINDOW=1 minute

# ---- 上传与视频 ----
MC_MAX_UPLOAD_MB=20            # 普通文件上传上限（题库导入等）
MC_MAX_VIDEO_MB=2048           # 视频上传上限
MC_MEDIA_ROOTS=                # 允许登记为「媒体目录」的宿主机路径（逗号分隔）
MC_FFMPEG_PATH=ffmpeg          # 需要视频转码/抽帧时指定
MC_FFPROBE_PATH=ffprobe
