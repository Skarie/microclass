#!/bin/bash
# 升级前：把数据目录（SQLite + 上传文件）打包备份，失败则中止升级。
set -u

LOG_FILE="${TRIM_PKGVAR}/info.log"
BACKUP_DIR="${TRIM_PKGVAR}/backup"
mkdir -p "${BACKUP_DIR}"
STAMP="$(date '+%Y%m%d-%H%M%S')"

if [ -d "${TRIM_PKGVAR}/data" ]; then
    if tar -czf "${BACKUP_DIR}/pre-upgrade-${STAMP}.tar.gz" -C "${TRIM_PKGVAR}" data >> "${LOG_FILE}" 2>&1; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') - upgrade_init: backup written to ${BACKUP_DIR}/pre-upgrade-${STAMP}.tar.gz" >> "${LOG_FILE}"
    else
        echo "$(date '+%Y-%m-%d %H:%M:%S') - upgrade_init: backup FAILED, aborting upgrade" >> "${LOG_FILE}"
        exit 1
    fi
    # 只保留最近 5 份
    ls -1t "${BACKUP_DIR}"/pre-upgrade-*.tar.gz 2>/dev/null | tail -n +6 | xargs -r rm -f
fi

exit 0