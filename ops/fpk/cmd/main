#!/bin/bash
# 微课堂 fnOS 学生端 —— 应用生命周期入口（fnpack / 应用中心调用 start | stop | status）
#
# 形态：学生端网关（静态资源 + /api 反代到 Docker 生产），本身不持有数据库。
# 由 fnOS 注入的变量（实测 fnOS 1.2.1102）：
#   TRIM_PKGVAR  = /vol1/@appdata/<appname>  （日志/PID；不再存业务数据）
#   TRIM_APPDEST = /vol1/@appcenter/<appname>（程序目录，升级会替换）
# 注意：新版 fnOS 只注入 TRIM_APPDEST，没有 TRIM_PKGDIR；本脚本带 set -u，
# 引用未定义变量会直接退出，应用中心表现为启动失败（错误码 10330）。
set -u

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
# 端口默认 8092（与 app/ui/config 的桌面入口一致）
PORT="${MC_PORT:-8092}"
# 上游：Docker 生产 API（账号/学习记录/题库都在这边）
UPSTREAM="${MC_UPSTREAM:-http://127.0.0.1:8091}"

# fnpack 把 app/ 的内容直接解包到程序目录根下（config/ server/ ui/），
# 因此网关目录是 <程序目录>/server；写成 app/server 会 cd 失败、应用起不来。
PROGRAM_DIR="${TRIM_APPDEST:-${TRIM_PKGDIR:-}}"
if [ -z "${PROGRAM_DIR}" ]; then
    echo "TRIM_APPDEST/TRIM_PKGDIR 均未设置，无法定位程序目录" >&2
    exit 1
fi
APP_DIR="${PROGRAM_DIR}/server"
# 版本号以 fnOS 注入的 TRIM_APPVER 为准（横幅/日志用），manifest 作为兜底
APP_VERSION="${TRIM_APPVER:-}"
if [ -z "${APP_VERSION}" ] && [ -f "${PROGRAM_DIR}/manifest" ]; then
    APP_VERSION="$(sed -n 's/^version[[:space:]]*=[[:space:]]*//p' "${PROGRAM_DIR}/manifest" 2>/dev/null | head -n 1 | tr -d '[:space:]')"
fi
NODE_BIN="/vol1/@appcenter/nodejs_v22/bin/node"
[ -x "${NODE_BIN}" ] || NODE_BIN="$(command -v node)"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

check_process() {
    local pid=$1
    [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

# 健康探针：网关把 /api/v1/healthz 反代到 Docker，因此这个探针同时反映上游状态。
# fnOS 有时会清理 $TRIM_PKGVAR 下的 pid 文件，此时不能凭 pid 文件判定「未运行」，
# 否则应用中心会报启动失败（10500）。
health_ok() {
    command -v curl >/dev/null 2>&1 &&
        curl -fsS -m 3 "http://127.0.0.1:${PORT}/api/v1/healthz" >/dev/null 2>&1
}

# 按进程命令行找回网关 pid（pid 文件丢失时兜底）
find_server_pid() {
    pgrep -f "${APP_DIR}/proxy.mjs" 2>/dev/null | head -n 1
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    if health_ok; then
        pid="$(find_server_pid)"
        [ -n "${pid}" ] && printf "%s" "${pid}" > "${PID_FILE}"
        return 0
    fi
    return 1
}

start_process() {
    if status; then
        return 0
    fi

    log_msg "starting student gateway on port ${PORT} (upstream ${UPSTREAM}, v${APP_VERSION:-unknown})"
    cd "${APP_DIR}" || exit 1
    MC_PORT="${PORT}" \
    MC_HOST=0.0.0.0 \
    MC_WEB_DIST="${APP_DIR}/web" \
    MC_UPSTREAM="${UPSTREAM}" \
    TZ=Asia/Shanghai \
    "${NODE_BIN}" "${APP_DIR}/proxy.mjs" >> "${LOG_FILE}" 2>&1 &

    printf "%s" "$!" > "${PID_FILE}"
    sleep 1
    if status; then
        log_msg "started, pid=$(cat "${PID_FILE}")"
        return 0
    fi
    log_msg "failed to start, see ${LOG_FILE}"
    return 1
}

stop_process() {
    local pid=""
    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
    fi
    # pid 文件缺失但进程仍在（fnOS 清理过 pid 文件）时按命令行兜底
    if ! check_process "${pid}"; then
        pid="$(find_server_pid)"
    fi
    if check_process "${pid}"; then
        log_msg "stopping pid=${pid}"
        kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1
        local count=0
        while check_process "${pid}" && [ ${count} -lt 15 ]; do
            sleep 1
            count=$((count + 1))
        done
        if check_process "${pid}"; then
            log_msg "force killing pid=${pid}"
            kill -KILL "${pid}"
        fi
    fi
    rm -f "${PID_FILE}"
    return 0
}

case "$1" in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then exit 0; else exit 3; fi
    ;;
*)
    exit 1
    ;;
esac
