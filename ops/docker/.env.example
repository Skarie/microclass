# Docker Compose 环境变量示例：复制为 .env 后填写
# cp .env.example .env

# 必填：管理员初始密码（首次启动引导创建；已存在则不会覆盖）
MC_ADMIN_PASS=change-me-please

# 会话签名密钥（留空则自动生成并持久化到数据卷 data/.secret）
MC_SESSION_SECRET=

# 媒体根目录（JSON 数组；容器内路径，需与下面的 volumes 挂载一致）
MC_MEDIA_ROOTS=[{"id":"nas","name":"NAS 视频","path":"/media/nas"}]

# 是否开放学生自助注册
MC_ALLOW_REGISTER=true

# 站点名与端口
MC_SITE_NAME=微课堂
MC_PORT=8091
